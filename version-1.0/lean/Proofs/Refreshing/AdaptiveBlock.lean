import Proofs.Refreshing.Comparison
import Mathlib.Probability.ProbabilityMassFunction.Constructions

/-!
# Adaptive block accounting

Unsigned suffixes are probability kernels and therefore contract signed L₁ mass. A preceding unsigned factor is a probability and can be dropped when bounding an absolute local error. Enumerating that answer and the two block answers costs exactly three powers of the answer-alphabet cardinality.
-/

noncomputable section
open scoped BigOperators ENNReal
namespace RefreshingProof

/-- Apply a real kernel to arbitrary finite signed masses. -/
def signedKernelApply {X Y : Type*} [Fintype X] (u : X → ℝ) (k : X → Y → ℝ) : Y → ℝ :=
  fun y => ∑ x, u x * k x y

/-- Backwards elimination of a normalized unsigned suffix, with no positivity assumption on the signed incoming mass. -/
theorem signedKernel_l1_contraction {X Y : Type*} [Fintype X] [Fintype Y]
    (u : X → ℝ) (k : X → Y → ℝ)
    (hk : ∀ x y, 0 ≤ k x y) (hnorm : ∀ x, ∑ y, k x y = 1) :
    ∑ y, |signedKernelApply u k y| ≤ ∑ x, |u x| := by
  unfold signedKernelApply
  calc
    _ ≤ ∑ y, ∑ x, |u x * k x y| := by
      apply Finset.sum_le_sum
      intro y _
      exact Finset.abs_sum_le_sum_abs _ _
    _ = ∑ x, |u x| * (∑ y, k x y) := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro x _
      simp_rw [abs_mul, abs_of_nonneg (hk x _)]
      rw [Finset.mul_sum]
    _ = _ := by simp only [hnorm, mul_one]

/-- The real point masses of any finite PMF sum to one. -/
theorem sum_pmf_real {X : Type*} [Fintype X] (p : PMF X) : ∑ x, (p x).toReal = 1 := by
  rw [← ENNReal.toReal_sum (fun x _ => p.apply_ne_top x)]
  simpa only [tsum_fintype, ENNReal.toReal_one] using congrArg ENNReal.toReal p.tsum_coe

/-- Specialize suffix elimination to a genuine probability kernel, which includes the adaptive suffixes generated by `conditionalAnswer`. -/
theorem signedPMFKernel_l1_contraction {X Y : Type*} [Fintype X] [Fintype Y]
    (u : X → ℝ) (k : X → PMF Y) :
    ∑ y, |signedKernelApply u (fun x y => (k x y).toReal) y| ≤ ∑ x, |u x| :=
  signedKernel_l1_contraction u _ (fun _ _ => ENNReal.toReal_nonneg) (fun x => sum_pmf_real (k x))

/-- The ordered triple of complete answers in a three-round comparison window. -/
abbrev ThreeAnswers (Z : Type*) := Z × Z × Z
/-- Index a local comparison by its preceding data, three answers, and the two auxiliary factor indices. -/
abbrev BlockIndex (C Z A B : Type*) := C × ThreeAnswers Z × A × B

/-- Signed local error before a suffix is run. `P` is an arbitrary joint distribution of all preceding data, including earlier states and the formal history. The preceding unsigned round has conditional answer distribution `p`. -/
def blockBaseMass {C Z A B : Type*}
    (P : PMF C) (μA : PMF A) (μB : PMF B) (p : C → A → PMF Z)
    (E : C → ThreeAnswers Z → A → B → ℝ) : BlockIndex C Z A B → ℝ :=
  fun v => (P v.1).toReal * (μA v.2.2.1).toReal * (μB v.2.2.2).toReal *
    (p v.1 v.2.2.1 v.2.1.1).toReal * E v.1 v.2.1 v.2.2.1 v.2.2.2

/-- Drop the preceding true probability factor pointwise. Its dependence on both the earlier context and the block's first state is allowed. -/
theorem blockBaseMass_abs_le {C Z A B : Type*}
    (P : PMF C) (μA : PMF A) (μB : PMF B) (p : C → A → PMF Z)
    (E : C → ThreeAnswers Z → A → B → ℝ) (v : BlockIndex C Z A B) :
    |blockBaseMass P μA μB p E v| ≤
      (P v.1).toReal * (μA v.2.2.1).toReal * (μB v.2.2.2).toReal *
        |E v.1 v.2.1 v.2.2.1 v.2.2.2| := by
  have hp : (p v.1 v.2.2.1 v.2.1.1).toReal ≤ 1 := by
    simpa using ENNReal.toReal_mono ENNReal.one_ne_top ((p v.1 v.2.2.1).coe_le_one v.2.1.1)
  unfold blockBaseMass
  simp only [abs_mul, abs_of_nonneg ENNReal.toReal_nonneg]
  calc
    _ = ((P v.1).toReal * (μA v.2.2.1).toReal * (μB v.2.2.2).toReal *
          |E v.1 v.2.1 v.2.2.1 v.2.2.2|) * (p v.1 v.2.2.1 v.2.1.1).toReal := by ring
    _ ≤ ((P v.1).toReal * (μA v.2.2.1).toReal * (μB v.2.2.2).toReal *
          |E v.1 v.2.1 v.2.2.1 v.2.2.2|) * 1 :=
      mul_le_mul_of_nonneg_left hp (by positivity)
    _ = _ := mul_one _

/-- The paper's K³ enumeration bound, derived from a per-answer local error bound averaged over the block's independent outer-state distributions. -/
theorem blockBaseMass_l1_le {C Z A B : Type*}
    [Fintype C] [Fintype Z] [Fintype A] [Fintype B]
    (P : PMF C) (μA : PMF A) (μB : PMF B) (p : C → A → PMF Z)
    (E : C → ThreeAnswers Z → A → B → ℝ) (δ : ℝ)
    (hlocal : ∀ c z,
      (∑ a, (μA a).toReal * (∑ b, (μB b).toReal * |E c z a b|)) ≤ δ) :
    ∑ v, |blockBaseMass P μA μB p E v| ≤ (Fintype.card Z : ℝ) ^ 3 * δ := by
  calc
    _ ≤ ∑ v : BlockIndex C Z A B,
        (P v.1).toReal * (μA v.2.2.1).toReal * (μB v.2.2.2).toReal *
          |E v.1 v.2.1 v.2.2.1 v.2.2.2| :=
      Finset.sum_le_sum (fun v _ => blockBaseMass_abs_le P μA μB p E v)
    _ = ∑ c, (P c).toReal * ∑ z : ThreeAnswers Z,
        ∑ a, (μA a).toReal * (∑ b, (μB b).toReal * |E c z a b|) := by
      simp only [Fintype.sum_prod_type]
      simp_rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro c _
      apply Finset.sum_congr rfl
      intro z₀ _
      apply Finset.sum_congr rfl
      intro z₁ _
      apply Finset.sum_congr rfl
      intro z₂ _
      apply Finset.sum_congr rfl
      intro a _
      apply Finset.sum_congr rfl
      intro b _
      ring
    _ ≤ ∑ c, (P c).toReal * ∑ _z : ThreeAnswers Z, δ := by
      apply Finset.sum_le_sum
      intro c _
      exact mul_le_mul_of_nonneg_left (Finset.sum_le_sum (fun z _ => hlocal c z))
        ENNReal.toReal_nonneg
    _ = (Fintype.card Z : ℝ) ^ 3 * δ := by
      simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      rw [← Finset.sum_mul, sum_pmf_real]
      simp only [Fintype.card_prod, Nat.cast_mul]
      ring

/-- Complete adaptive block accounting: first eliminate the normalized suffix, then enumerate only the preceding answer and the two block answers. -/
theorem adaptive_block_K3 {C Z A B R : Type*}
    [Fintype C] [Fintype Z] [Fintype A] [Fintype B] [Fintype R]
    (P : PMF C) (μA : PMF A) (μB : PMF B) (p : C → A → PMF Z)
    (E : C → ThreeAnswers Z → A → B → ℝ)
    (suffix : BlockIndex C Z A B → PMF R) (δ : ℝ)
    (hlocal : ∀ c z,
      (∑ a, (μA a).toReal * (∑ b, (μB b).toReal * |E c z a b|)) ≤ δ) :
    (∑ r, |signedKernelApply (blockBaseMass P μA μB p E)
        (fun v r => (suffix v r).toReal) r|) ≤ (Fintype.card Z : ℝ) ^ 3 * δ :=
  (signedPMFKernel_l1_contraction _ _).trans (blockBaseMass_l1_le P μA μB p E δ hlocal)

end RefreshingProof
